{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Shopee Likes",
  "version": "0.1.0",
  "description": "A small open-source desktop view for your Shopee liked products.",
  "homepage_url": "https://drayah.github.io/shopee-likes/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://shopee.com.br/*",
    "https://shopee.co.id/*",
    "https://shopee.com.my/*",
    "https://shopee.ph/*",
    "https://shopee.sg/*",
    "https://shopee.co.th/*",
    "https://shopee.tw/*",
    "https://shopee.vn/*"
  ],
  "action": {
    "default_title": "Shopee Likes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.com.br/*",
        "https://shopee.co.id/*",
        "https://shopee.com.my/*",
        "https://shopee.ph/*",
        "https://shopee.sg/*",
        "https://shopee.co.th/*",
        "https://shopee.tw/*",
        "https://shopee.vn/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.com.br/*",
        "https://shopee.co.id/*",
        "https://shopee.com.my/*",
        "https://shopee.ph/*",
        "https://shopee.sg/*",
        "https://shopee.co.th/*",
        "https://shopee.tw/*",
        "https://shopee.vn/*"
      ],
      "js": [
        "src/markets.js",
        "src/api.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
